{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uprivate-intelligence-api",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "8681f9abc29572d2ea09be866b251519",
  "d1_databases": [{
    "binding": "DB", "database_name": "uprivate-intelligence",
    "database_id": "796475b7-6819-48fe-b61e-16971d36c985"
  }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "ad4b5092f4a6449593e8d916c3ea4586" }],
  "ratelimits": [{
    "name": "REQUEST_LIMITER", "namespace_id": "2001",
    "simple": { "limit": 60, "period": 60 }
  }],
  "observability": { "enabled": true },
  "vars": { "PROBE_ENABLED": "true", "PROCESSING_ENABLED": "true" }
}
