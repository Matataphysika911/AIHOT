{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uprivate-intelligence-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": ["*/15 * * * *", "20 20 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uprivate-intelligence",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_ARCHIVE",
      "bucket_name": "uprivate-intelligence-raw"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SOURCE_QUEUE",
        "queue": "uprivate-source-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "uprivate-source-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "uprivate-source-jobs-dlq"
      }
    ]
  },
  "vars": {
    "OLD_NEWS_HOURS": "48",
    "DEFAULT_FETCH_MINUTES": "120"
  }
}
