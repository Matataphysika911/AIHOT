{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uprivate-intelligence-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "20 20 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uprivate-intelligence",
      "database_id": "796475b7-6819-48fe-b61e-16971d36c985",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_ARCHIVE",
      "bucket_name": "uprivate-intelligence-raw"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SOURCE_QUEUE",
        "queue": "uprivate-source-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "uprivate-source-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "uprivate-source-jobs-dlq"
      }
    ]
  },
  "vars": {
    "OLD_NEWS_HOURS": "48",
    "DEFAULT_FETCH_MINUTES": "120"
  },
  "account_id": "8681f9abc29572d2ea09be866b251519"
}
